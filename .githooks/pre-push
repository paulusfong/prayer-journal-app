#!/usr/bin/env bash
# Same scope as CI: unit + mutation for files changed vs origin/main (the PR range).
# Prefer: npm run open-pr — so mutation fails locally before the PR exists.
set -euo pipefail
if [[ "${SKIP_PR_CHECK:-}" == "1" ]]; then
  echo "SKIP_PR_CHECK=1 — skipping pre-push CI check"
  exit 0
fi
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: running scoped CI (includes mutation). Prefer npm run open-pr next time."
exec node scripts/check-pr.mjs --pr
