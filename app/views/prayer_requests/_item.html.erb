<li class="request-card <%= prayer_request.visibility %>">
  <%= link_to prayer_request do %>
    <h2><%= prayer_request.title %></h2>
    <p class="meta">
      <% if prayer_request.visibility_private? %>Private · <% end %>
      <%= prayer_request.author.display_label %>
      <% if prayer_request.who_for.present? %> · for <%= prayer_request.who_for %><% end %>
      <% if prayer_request.category_label %> · <%= prayer_request.category_label %><% end %>
      <% if prayer_request.hope_by.present? %> · <%= hope_by_label(prayer_request) %><% end %>
      <% if prayer_request.status_answered? && prayer_request.answered_at %> · answered <%= prayer_request.answered_at.to_date.to_fs(:long) %><% end %>
      · <%= pluralize(prayer_request.prayer_marks_count, "prayed") %>
    </p>
  <% end %>
</li>
