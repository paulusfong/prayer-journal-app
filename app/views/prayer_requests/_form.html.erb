<%= form_with model: prayer_request do |f| %>
  <% if prayer_request.errors.any? %>
    <div class="errors">
      <ul>
        <% prayer_request.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.label :title, "Title" %>
  <%= f.text_field :title, required: true, maxlength: 120 %>

  <%= f.label :body, "The ask (optional)" %>
  <%= f.text_area :body, rows: 5, maxlength: 2000 %>

  <%= f.label :who_for, "Who is this for? (optional)" %>
  <%= f.text_field :who_for, maxlength: 80 %>

  <%= f.label :category, "Category (optional)" %>
  <%= f.select :category, PrayerRequest::CATEGORIES.map { |k, v| [ v, k ] }, { include_blank: "None" } %>

  <%= f.label :category_other, "If other, say what" %>
  <%= f.text_field :category_other, maxlength: 80 %>

  <%= f.label :hope_by, "Hope-by date (optional)" %>
  <%= f.date_field :hope_by %>

  <fieldset>
    <legend>Who can see this</legend>
    <label class="choice">
      <%= f.radio_button :visibility, "circle" %> Whole circle
    </label>
    <label class="choice">
      <%= f.radio_button :visibility, "private" %> Only me
    </label>
  </fieldset>

  <%= f.submit prayer_request.persisted? ? "Save" : "Log request" %>
<% end %>
