<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · Prayer Journal" : "Prayer Journal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="shell">
      <header class="mast">
        <a class="wordmark" href="<%= authenticated? && Current.user&.memberships&.approved&.any? ? root_path : (authenticated? ? pending_path : new_session_path) %>">Prayer Journal</a>
        <% if authenticated? %>
          <nav class="nav">
            <% if Current.membership&.approved? %>
              <%= link_to "Open", root_path %>
              <%= link_to "Answered", answered_prayer_requests_path %>
              <%= link_to "New request", new_prayer_request_path %>
              <% if Current.membership.owner? %>
                <%= link_to "Circle", memberships_path %>
              <% end %>
            <% end %>
            <%= link_to Current.user.display_label, edit_profile_path %>
            <%= button_to "Sign out", session_path, method: :delete, class: "text-btn" %>
          </nav>
        <% end %>
      </header>

      <% if notice %><p class="flash flash-notice" role="status"><%= notice %></p><% end %>
      <% if alert %><p class="flash flash-alert" role="alert"><%= alert %></p><% end %>

      <main>
        <%= yield %>
      </main>

      <footer class="colophon">
        <%= link_to "Privacy", privacy_path %>
      </footer>
    </div>
  </body>
</html>
