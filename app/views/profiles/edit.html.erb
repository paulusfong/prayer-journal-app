<% page_title "Your name" %>
<section class="panel">
  <h1>What should we call you?</h1>
  <p class="lede">Shown next to “I prayed” and notes. Email stays private.</p>

  <%= form_with model: @user, url: profile_path, method: :patch do |f| %>
    <%= f.label :display_name, "Display name" %>
    <%= f.text_field :display_name, maxlength: 80 %>
    <%= f.submit "Save" %>
  <% end %>

  <% if session[:prompt_display_name] %>
    <%= button_to "Skip for now", skip_profile_path, method: :post, class: "text-btn" %>
  <% end %>
</section>
