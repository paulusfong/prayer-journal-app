<% page_title "Circle" %>
<section class="panel">
  <h1><%= current_circle.name %></h1>

  <h2>Invite</h2>
  <% if @invite %>
    <p class="invite-url"><code><%= join_url(@invite.token) %></code></p>
    <p class="muted">Reusable until <%= @invite.expires_at.to_date.to_fs(:long) %>. Anyone with the link still needs your approval.</p>
  <% else %>
    <p class="muted">No active invite link.</p>
  <% end %>
  <%= button_to "Reset invite link", invites_path, method: :post %>
  <% if flash[:invite_url] %>
    <p class="flash flash-notice">New link: <code><%= flash[:invite_url] %></code></p>
  <% end %>

  <h2>Waiting <%= %( (#{@pending.size})) if @pending.any? %></h2>
  <% if @pending.any? %>
    <ul class="people">
      <% @pending.each do |membership| %>
        <li>
          <span><%= membership.user.display_label %> · <%= membership.user.email_address %></span>
          <%= button_to "Approve", membership_path(membership, decision: "approve"), method: :patch, class: "btn-small" %>
          <%= button_to "Decline", membership_path(membership, decision: "decline"), method: :patch, class: "btn-small danger" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">No one waiting.</p>
  <% end %>

  <h2>Members</h2>
  <ul class="people">
    <% @members.each do |membership| %>
      <li>
        <span><%= membership.user.display_label %><% if membership.owner? %> · owner<% end %></span>
        <% unless membership.user_id == Current.user.id %>
          <%= button_to "Remove", membership_path(membership), method: :delete, class: "btn-small danger", form: { data: { turbo_confirm: "Remove this person from the circle?" } } %>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
